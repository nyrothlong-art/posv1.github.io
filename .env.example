# ===== ចាំបាច់ =====
JWT_SECRET=ប្តូរទៅជាអក្សរចៃដន្យវែងៗ-យ៉ាងតិច-32-តួ
ADMIN_PASSWORD=ដាក់ពាក្យសម្ងាត់-Admin-របស់អ្នក
# Origin របស់ GitHub Pages (គ្មាន / នៅចុង) អាចដាក់ច្រើនដោយបំបែកដោយ ,
ALLOWED_ORIGINS=https://USERNAME.github.io

# ===== ជម្រើស =====
PORT=3000
DB_PATH=./data/pos.db

# Telegram (ឬដាក់តាមទំព័រ Settings ក្នុងកម្មវិធីក៏បាន)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail (ប្រើ App Password មិនមែនពាក្យសម្ងាត់ Gmail ធម្មតាទេ)
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL_TO=
